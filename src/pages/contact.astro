---
import Base from '../layouts/Base.astro';
import site from '../data/locations.json';

const melville =
  site.locations.find((location) =>
    location.name.toLowerCase().includes('melville')
  );

const commack =
  site.locations.find((location) =>
    location.name.toLowerCase().includes('commack')
  );
---

<Base
  title="Contact | Art In Motion Dance Center"
  description="Contact Art In Motion Dance Center in Melville or Commack, New York. Ask about classes, registration, programs, events and dance training."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="aim-contact-hero">

    <div
      class="aim-contact-hero-mark"
      aria-hidden="true"
    >
      AIM
    </div>

    <div class="wrap aim-contact-hero-inner">

      <div>

        <div class="eyebrow light">
          We'd love to hear from you
        </div>

        <h1>
          Contact us.
        </h1>

        <p>
          Questions about classes, registration, company training,
          events or parties? Connect with the AIM team and we'll
          point you in the right direction.
        </p>

      </div>

    </div>

  </section>



  <!-- =====================================================
       CONTACT CONTENT
       ===================================================== -->

  <section class="aim-contact-main">

    <div class="wrap">

      <div class="aim-contact-heading">

        <div>

          <div class="eyebrow">
            Get in touch
          </div>

          <h2>
            How can we help?
          </h2>

        </div>

        <p>
          Send us a message using the form or contact the studio
          location most convenient for you.
        </p>

      </div>



      <div class="aim-contact-layout">


        <!-- =================================================
             LEFT COLUMN
             ================================================= -->

        <aside class="aim-contact-locations">


          <!-- MELVILLE -->

          <article class="aim-location-card">

            <div class="aim-location-number">
              01
            </div>

            <div class="aim-location-card-content">

              <div class="eyebrow">
                Melville Center
              </div>

              <h3>
                Melville
              </h3>

              <div class="aim-location-details">

                <p>
                  165 Walt Whitman Rd,<br/>
                  Melville, NY 11747
                </p>

                <a href="tel:6314242243">
                  (631) 424-2243
                </a>

                <a href="mailto:siobhan@aimdanceny.com">
                  siobhan@aimdanceny.com
                </a>

              </div>


              <div class="aim-location-actions">

                {melville?.portal && (

                  <a
                    class="btn"
                    href={melville.portal}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Parent Portal ↗
                  </a>

                )}

                <a
                  class="aim-direction-link"
                  href="https://www.google.com/maps/search/?api=1&query=165+Walt+Whitman+Rd+Melville+NY+11747"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Directions ↗
                </a>

              </div>

            </div>

          </article>



          <!-- COMMACK -->

          <article class="aim-location-card">

            <div class="aim-location-number">
              02
            </div>

            <div class="aim-location-card-content">

              <div class="eyebrow">
                Commack Center
              </div>

              <h3>
                Commack
              </h3>

              <div class="aim-location-details">

                <p>
                  6090 Jericho Turnpike,<br/>
                  Commack, NY 11725
                </p>

                <a href="tel:6316518656">
                  (631) 651-8656
                </a>

                <a href="mailto:info@aimdanceny.com">
                  info@aimdanceny.com
                </a>

              </div>


              <div class="aim-location-actions">

                {commack?.portal && (

                  <a
                    class="btn"
                    href={commack.portal}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Parent Portal ↗
                  </a>

                )}

                <a
                  class="aim-direction-link"
                  href="https://www.google.com/maps/search/?api=1&query=6090+Jericho+Turnpike+Commack+NY+11725"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Directions ↗
                </a>

              </div>

            </div>

          </article>



          <!-- SMALL HELP BLOCK -->

          <div class="aim-contact-help">

            <span>
              Not sure which studio?
            </span>

            <p>
              Send us a message and our team will help you find
              the right class, program and location.
            </p>

          </div>

        </aside>



        <!-- =================================================
             RIGHT COLUMN / JOTFORM
             ================================================= -->

        <div class="aim-contact-form-column">

          <div class="aim-contact-form-top">

            <span>
              Send us a message
            </span>

            <h3>
              Let's get you started.
            </h3>

            <p>
              Complete the form below and someone from the AIM team
              will be in touch.
            </p>

          </div>


          <div class="aim-jotform-shell">

            <script
              is:inline
              type="text/javascript"
              src="https://form.jotform.com/jsform/262846694835171"
            ></script>

          </div>

        </div>


      </div>

    </div>

  </section>



  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <section class="aim-contact-cta">

    <div class="wrap aim-contact-cta-inner">

      <div>

        <div class="eyebrow light">
          Ready to dance?
        </div>

        <h2>
          Find your place at AIM.
        </h2>

      </div>


      <a
        class="btn btn-light"
        href="/schedules"
      >
        View schedules
      </a>

    </div>

  </section>



  <!-- =====================================================
       PAGE STYLES
       ===================================================== -->

  <style is:global>

    /* =====================================================
       CONTACT HERO
       ===================================================== */

    .aim-contact-hero {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(
          135deg,
          #4a0015 0%,
          #72001f 55%,
          #98002c 100%
        );
      color: #fff;
    }

    .aim-contact-hero-inner {
      position: relative;
      z-index: 2;
      display: flex;
      align-items: center;
      min-height: 380px;
      padding-top: 70px;
      padding-bottom: 70px;
    }

    .aim-contact-hero-inner > div {
      max-width: 760px;
    }

    .aim-contact-hero h1 {
      margin: 16px 0 20px;
      color: #fff;
      font-size: clamp(4rem, 8vw, 7rem);
      line-height: .9;
      letter-spacing: -.035em;
      text-transform: uppercase;
    }

    .aim-contact-hero p {
      max-width: 650px;
      margin: 0;
      color: rgba(255,255,255,.9);
      font-size: 1.08rem;
      line-height: 1.75;
    }

    .aim-contact-hero-mark {
      position: absolute;
      top: -60px;
      right: -20px;
      color: rgba(255,255,255,.035);
      font-size: clamp(13rem, 28vw, 30rem);
      font-weight: 900;
      line-height: 1;
      pointer-events: none;
      user-select: none;
    }



    /* =====================================================
       MAIN SECTION
       ===================================================== */

    .aim-contact-main {
      padding: 100px 0 120px;
      background: #faf7f7;
    }

    .aim-contact-heading {
      display: grid;
      grid-template-columns: 1fr .85fr;
      gap: 70px;
      align-items: end;
      margin-bottom: 55px;
    }

    .aim-contact-heading h2 {
      margin: 10px 0 0;
      color: var(--burgundy);
      font-size: clamp(3rem, 5vw, 5rem);
      line-height: .95;
    }

    .aim-contact-heading > p {
      max-width: 520px;
      margin: 0;
      color: var(--muted);
      font-size: 1rem;
      line-height: 1.75;
    }



    /* =====================================================
       TWO COLUMN LAYOUT
       ===================================================== */

    .aim-contact-layout {
      display: grid;
      grid-template-columns:
        minmax(300px, .78fr)
        minmax(0, 1.22fr);
      gap: 32px;
      align-items: start;
    }



    /* =====================================================
       LOCATION COLUMN
       ===================================================== */

    .aim-contact-locations {
      display: grid;
      gap: 20px;
    }

    .aim-location-card {
      position: relative;
      overflow: hidden;
      border: 1px solid rgba(128,0,32,.12);
      border-radius: 22px;
      background: #fff;
      box-shadow: 0 16px 40px rgba(50,10,22,.05);
    }

    .aim-location-number {
      position: absolute;
      top: 20px;
      right: 24px;
      color: rgba(128,0,32,.08);
      font-size: 4.5rem;
      font-weight: 900;
      line-height: 1;
    }

    .aim-location-card-content {
      position: relative;
      z-index: 2;
      padding: 36px;
    }

    .aim-location-card h3 {
      margin: 12px 0 14px;
      color: var(--burgundy);
      font-size: 2.3rem;
      line-height: 1;
    }

    .aim-location-details {
      display: grid;
      gap: 7px;
      margin-bottom: 26px;
    }

    .aim-location-details p {
      margin: 0 0 4px;
      color: #2e2528;
      line-height: 1.6;
    }

    .aim-location-details a {
      width: fit-content;
      color: var(--burgundy);
      font-weight: 600;
      text-decoration: none;
    }

    .aim-location-details a:hover {
      text-decoration: underline;
    }



    /* =====================================================
       LOCATION BUTTONS
       ===================================================== */

    .aim-location-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .aim-direction-link {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 47px;
      padding: 0 19px;
      border: 1px solid var(--burgundy);
      border-radius: 999px;
      color: var(--burgundy);
      font-size: .88rem;
      font-weight: 800;
      text-decoration: none;
      transition:
        background .2s ease,
        color .2s ease;
    }

    .aim-direction-link:hover {
      background: var(--burgundy);
      color: #fff;
    }



    /* =====================================================
       HELP BLOCK
       ===================================================== */

    .aim-contact-help {
      padding: 27px 30px;
      border-radius: 20px;
      background: var(--burgundy);
      color: #fff;
    }

    .aim-contact-help span {
      display: block;
      margin-bottom: 7px;
      font-size: .75rem;
      font-weight: 800;
      letter-spacing: .12em;
      text-transform: uppercase;
    }

    .aim-contact-help p {
      margin: 0;
      color: rgba(255,255,255,.88);
      font-size: .92rem;
      line-height: 1.7;
    }



    /* =====================================================
       FORM COLUMN
       ===================================================== */

    .aim-contact-form-column {
      overflow: hidden;
      border: 1px solid rgba(128,0,32,.1);
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 22px 55px rgba(50,10,22,.08);
    }

    .aim-contact-form-top {
      padding: 36px 40px 10px;
    }

    .aim-contact-form-top > span {
      color: var(--burgundy);
      font-size: .72rem;
      font-weight: 800;
      letter-spacing: .15em;
      text-transform: uppercase;
    }

    .aim-contact-form-top h3 {
      margin: 8px 0 10px;
      color: var(--burgundy);
      font-size: clamp(2.2rem, 4vw, 3.5rem);
      line-height: 1;
    }

    .aim-contact-form-top p {
      max-width: 570px;
      margin: 0;
      color: var(--muted);
      font-size: .95rem;
      line-height: 1.7;
    }

    .aim-jotform-shell {
      width: 100%;
      padding: 0 12px 18px;
      background: #fff;
    }

    .aim-jotform-shell iframe {
      display: block !important;
      width: 100% !important;
      max-width: 100% !important;
      border: 0 !important;
    }



    /* =====================================================
       FINAL CTA
       ===================================================== */

    .aim-contact-cta {
      padding: 70px 0;
      background: var(--burgundy-deep);
      color: #fff;
    }

    .aim-contact-cta-inner {
      display: flex;
      justify-content: space-between;
      gap: 40px;
      align-items: center;
    }

    .aim-contact-cta h2 {
      margin: 8px 0 0;
      color: #fff;
      font-size: clamp(2.5rem, 5vw, 4.5rem);
      line-height: .95;
    }



    /* =====================================================
       TABLET
       ===================================================== */

    @media (max-width: 950px) {

      .aim-contact-heading {
        grid-template-columns: 1fr;
        gap: 20px;
      }

      .aim-contact-layout {
        grid-template-columns: 1fr;
      }

      .aim-contact-locations {
        grid-template-columns: 1fr 1fr;
      }

      .aim-contact-help {
        grid-column: 1 / 3;
      }

    }



    /* =====================================================
       MOBILE
       ===================================================== */

    @media (max-width: 650px) {

      .aim-contact-hero-inner {
        min-height: 320px;
        padding-top: 55px;
        padding-bottom: 55px;
      }

      .aim-contact-main {
        padding: 70px 0 80px;
      }

      .aim-contact-locations {
        grid-template-columns: 1fr;
      }

      .aim-contact-help {
        grid-column: auto;
      }

      .aim-location-card-content {
        padding: 28px 24px;
      }

      .aim-location-number {
        right: 18px;
        font-size: 3.7rem;
      }

      .aim-contact-form-top {
        padding: 30px 24px 8px;
      }

      .aim-jotform-shell {
        padding: 0 4px 12px;
      }

      .aim-contact-cta-inner {
        align-items: flex-start;
        flex-direction: column;
      }

    }

  </style>

</Base>
