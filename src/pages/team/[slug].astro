---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';


export async function getStaticPaths() {

  const staff = await getCollection('staff');

  return staff.map((s) => ({
    params: {
      slug: s.id
    },
    props: {
      s
    }
  }));

}


const { s } = Astro.props;

const { Content } = await render(s);

const hasBio = Boolean(s.body?.trim());


const initials = s.data.name
  .split(' ')
  .map((part) => part[0])
  .slice(0, 2)
  .join('');
---

<Base
  title={`${s.data.name} | AIM Dance`}
  description={`${s.data.name} — ${s.data.role} at Art In Motion Dance Center.`}
>


  <!-- =====================================================
       STAFF HERO
       ===================================================== -->

  <div class="subhero">

    <div class="wrap">

      <div class="eyebrow light">
        AIM Faculty
      </div>

      <h1>
        {s.data.name}
      </h1>

      <p>
        {s.data.role}
      </p>

    </div>

  </div>



  <!-- =====================================================
       STAFF PROFILE
       ===================================================== -->

  <section class="content-section">

    <div class="wrap faculty-profile">


      <div>

        {s.data.photo ? (

          <img
            class="faculty-photo"
            src={s.data.photo}
            alt={s.data.name}
          />

        ) : (

          <div
            class="faculty-photo ph"
            aria-hidden="true"
          >
            {initials}
          </div>

        )}

      </div>



      <div class="prose">


        {hasBio ? (

          <Content />

        ) : (

          <p>
            {s.data.name} is part of the Art In Motion Dance Center
            faculty. Visit our staff page or contact the studio for
            current teaching information.
          </p>

        )}


        <p>
          <a href="/staff">
            ← Back to all staff
          </a>
        </p>


      </div>


    </div>

  </section>


</Base>
