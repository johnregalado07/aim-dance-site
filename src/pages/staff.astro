---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
const staff = (await getCollection('staff')).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(staff.map(async (s) => ({ s, Content: (await render(s)).Content, hasBio: !!s.body?.trim() })));
const initials = (n: string) => n.split(' ').map((p) => p[0]).slice(0, 2).join('');
---
<Base title="Staff | AIM Dance">
  <div class="subhero"><div class="wrap"><h1>Our staff</h1><p>Teachers and choreographers who train and mentor AIM dancers.</p></div></div>
  <section><div class="wrap"><div class="staff">
    {items.map(({ s, Content, hasBio }) => (
      <div class="person">
        {s.data.photo ? <img src={s.data.photo} alt={s.data.name} loading="lazy" /> : <div class="ph" aria-hidden="true">{initials(s.data.name)}</div>}
        <h3>{s.data.name}</h3>
        <p class="meta">{s.data.role}</p>
        {hasBio && <details><summary>Read bio</summary><div class="prose"><Content /></div></details>}
      </div>
    ))}
  </div></div></section>
</Base>
