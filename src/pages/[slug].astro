---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const pages = (await getCollection('pages'))
    .filter((page) => page.id !== 'genres');

  return pages.map((page) => ({
    params: { slug: page.id },
    props: { page }
  }));
}

const { page } = Astro.props;
const { Content } = await render(page);

const allStaff = await getCollection('staff');

const kicklineStaffEntries = allStaff.filter((person) =>
  ['siobhan-santapaola', 'ali-ribellino'].includes(person.id)
);

const kicklineStaff = await Promise.all(
  kicklineStaffEntries.map(async (person) => {
    const { Content: BioContent } = await render(person);

    return {
      person,
      BioContent
    };
  })
);


/* =========================================================
   PAGE VISUALS
   ========================================================= */

const visuals = {

  'about-us': [
    '/uploads/client/general/general-4.jpg',
    '/uploads/client/general/general-8.jpg',
    '/uploads/client/general/general-11.jpg'
  ],

  'recreational-dance': [
    '/uploads/client/recreational/rec-1.jpg',
    '/uploads/client/recreational/rec-4.jpg',
    '/uploads/client/recreational/rec-7.jpg'
  ],

  'competition-team': [
    '/uploads/drive/general/competition.jpg',
    '/uploads/client/general/general-6.jpg',
    '/uploads/client/general/general-10.jpg'
  ],

  'genres': [
    '/uploads/drive/genres/ballet.jpg',
    '/uploads/drive/genres/jazz.jpg',
    '/uploads/drive/genres/tap.jpg',
    '/uploads/drive/genres/lyrical.png',
    '/uploads/drive/genres/contemporary.jpg',
    '/uploads/drive/genres/hip-hop.jpg',
    '/uploads/drive/genres/acro.jpg'
  ],

  'summer-programs': [
    '/uploads/drive/summer/summer-1.jpg',
    '/uploads/drive/summer/summer-2.png',
    '/uploads/drive/summer/summer-3.jpg'
  ],

  'birthday-parties': [
    '/uploads/drive/birthday/birthday.jpg',
    '/uploads/client/general/general-7.jpg',
    '/uploads/client/general/general-9.jpg'
  ],

  'kickline-technique': [
    '/uploads/drive/kickline/kickline-2.jpg',
    '/uploads/drive/kickline/kickline-1.jpg',
    '/uploads/drive/kickline/kickline-2.jpg',
    '/uploads/drive/kickline/kickline-3.jpg'
  ]

};


const gallery =
  visuals[page.id] ||
  [
    '/uploads/client/general/general-1.jpg',
    '/uploads/client/general/general-2.jpg',
    '/uploads/client/general/general-3.jpg'
  ];


const isProgram = page.data.section === 'programs';



/* =========================================================
   COMPETITION TEAMS
   ========================================================= */

const melvilleTeams = [

  {
    name: 'Minis',
    ages: 'Ages 5–8',
    image: '/uploads/drive/competition-teams/mel-minis.png'
  },

  {
    name: 'Petites',
    ages: 'Ages 8–10',
    image: '/uploads/drive/competition-teams/mel-petites.jpg'
  },

  {
    name: 'Juniors',
    ages: 'Ages 9–11',
    image: '/uploads/drive/competition-teams/mel-juniors.jpg'
  },

  {
    name: 'Teens',
    ages: 'Ages 10–14',
    image: '/uploads/drive/competition-teams/mel-teens.jpg'
  },

  {
    name: 'Seniors',
    ages: 'Ages 13–18',
    image: '/uploads/drive/competition-teams/mel-seniors.jpg'
  }

];


const commackTeams = [

  {
    name: 'Petites',
    ages: 'Ages 5–8',
    image: '/uploads/drive/competition-teams/com-petites.png'
  },

  {
    name: 'Juniors',
    ages: 'Ages 8–11',
    image: '/uploads/drive/competition-teams/com-juniors.jpg'
  },

  {
    name: 'Teens',
    ages: 'Ages 11–13',
    image: '/uploads/drive/competition-teams/com-teens.png'
  },

  {
    name: 'Seniors',
    ages: 'Ages 13–18',
    image: '/uploads/drive/competition-teams/com-seniors.png'
  }

];



/* =========================================================
   DANCER SPOTLIGHT
   ========================================================= */

const dancerFeatures = [

  {
    title: 'Taylor M- ID Influencer',
    image: '/uploads/drive/dancer-feature/taylor-m-id-influencer.jpg'
  },

  {
    title: 'Tessa S- KAR Protege',
    image: '/uploads/drive/dancer-feature/tessa-s-kar-protege.jpg'
  },

  {
    title: 'Spencer V- WILD Icon',
    image: '/uploads/drive/dancer-feature/spencer-v-wild-icon.jpg'
  },

  {
    title: 'Kenley M-Essentials Designs Costume Model',
    image: '/uploads/drive/dancer-feature/kenley-m-essentials-designs-costume-model.jpg'
  },

  {
    title: 'Reese W- Glamour Costumes Model',
    image: '/uploads/drive/dancer-feature/reese-w-glamour-costumes-model.jpg'
  },

  {
    title: 'Lucia A- Purple Pixies Ambassador',
    image: '/uploads/drive/dancer-feature/lucia-a-purple-pixies-ambassador.jpg'
  }

];
---

<Base
  title={`${page.data.title} | AIM Dance`}
  description={page.data.description}
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="editorial-hero">

    <img
      src={gallery[0]}
      alt={page.data.title}
      class="editorial-hero-img"
    />

    <div class="editorial-hero-overlay"></div>


    <div class="wrap editorial-hero-copy">

      <div class="eyebrow light">
        {isProgram
          ? 'AIM Programs'
          : 'Art In Motion Dance Center'
        }
      </div>

      <h1>
        {page.data.title}
      </h1>

      {page.data.description && (
        <p>
          {page.data.description}
        </p>
      )}

    </div>

  </section>



  <!-- =====================================================
       KICKLINE CONTENT
       ===================================================== -->

  {page.id === 'kickline-technique' ? (

    <section class="kickline-page-content">

      <div class="wrap">


        <div class="kickline-intro-grid">


          <div class="kickline-intro-heading">

            <div class="eyebrow">
              Train with AIM
            </div>

            <h2>
              Technique.<br/>
              Precision.<br/>
              Performance.
            </h2>

          </div>


          <div class="prose kickline-prose">
            <Content />
          </div>


        </div>



        <div class="kickline-photo-grid">


          {gallery.slice(1).map((src, i) => (

            <figure
              class={`kickline-photo kickline-photo-${i + 1}`}
            >

              <img
                src={src}
                alt={`Kickline Technique at AIM ${i + 1}`}
                loading="lazy"
              />

              <div class="kickline-photo-overlay"></div>

              <span>
                Kickline Technique
              </span>

            </figure>

          ))}


        </div>


      </div>

    </section>

  ) : (

    <section class="editorial-page">


      <div class="wrap editorial-grid">


        <aside class="editorial-aside">


          <div class="editorial-kicker">
            {isProgram
              ? 'Train with AIM'
              : 'The AIM difference'
            }
          </div>


          <h2>
            {isProgram
              ? 'Technique, confidence and community.'
              : 'Built for dancers who want to grow.'
            }
          </h2>


          <img
            src={gallery[1]}
            alt="AIM Dance"
            loading="lazy"
          />


          <a
            class="btn"
            href={isProgram
              ? '/schedules'
              : '/staff'
            }
          >
            {isProgram
              ? 'View schedules'
              : 'Meet our staff'
            }
          </a>


        </aside>



        <div class="prose editorial-prose">
          <Content />
        </div>


      </div>



      <div class="wrap editorial-gallery">


        {gallery.map((src, i) => (

          <figure
            class={`editorial-gallery-${i + 1}`}
          >

            <img
              src={src}
              alt={`${page.data.title} at AIM`}
              loading="lazy"
            />

          </figure>

        ))}


      </div>


    </section>

  )}



  <!-- =====================================================
       ABOUT VIDEO
       AUTOPLAY / MUTED / LOOP
       ===================================================== -->

  {page.id === 'about-us' && (

    <section class="about-video-feature">

      <div class="wrap about-video-grid">


        <div class="about-video-copy">

          <div class="eyebrow">
            Life at AIM
          </div>

          <h2>
            Cultivating artistry in motion.
          </h2>

          <p>
            Art In Motion is more than a place to take class. Our dancers
            train, perform and grow in an environment built around strong
            technique, confidence and a genuine love of movement.
          </p>

          <a
            class="text-link"
            href="/staff"
          >
            Meet the AIM team →
          </a>

        </div>



        <div class="about-video-media">

          <video
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Art In Motion Dance Center"
          >

            <source
              src="/uploads/drive/videos/about-aim-story.MP4"
              type="video/mp4"
            />

            Your browser does not support video playback.

          </video>

        </div>


      </div>

    </section>

  )}



  <!-- =====================================================
       COMPETITION VIDEOS
       AUTOPLAY / MUTED / LOOP
       ===================================================== -->

  {page.id === 'competition-team' && (

    <>

      <section class="competition-video-feature">

        <div class="wrap">


          <div class="competition-video-heading">


            <div>

              <div class="eyebrow light">
                Competition at AIM
              </div>

              <h2>
                Train hard.<br/>
                Perform with confidence.
              </h2>

            </div>


            <p>
              AIM company dancers develop strong technique,
              performance quality and confidence through focused
              training, rehearsals and performance opportunities.
            </p>


          </div>



          <div class="competition-video-grid">


            <article class="competition-video-card">

              <div class="competition-video-media">

                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="AIM Competition Team video 1"
                >

                  <source
                    src="/uploads/drive/videos/competition-1.mp4"
                    type="video/mp4"
                  />

                  Your browser does not support video playback.

                </video>

              </div>

            </article>



            <article class="competition-video-card">

              <div class="competition-video-media">

                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="AIM Competition Team video 2"
                >

                  <source
                    src="/uploads/drive/videos/competition-2.mp4"
                    type="video/mp4"
                  />

                  Your browser does not support video playback.

                </video>

              </div>

            </article>


          </div>


        </div>

      </section>



      <!-- =================================================
           COMPANY TRAINING REQUIREMENTS
           ================================================= -->

      <section class="intro-section">

        <div class="wrap intro-grid">


          <div>

            <div class="eyebrow">
              Company Training
            </div>

            <h2>
              Training built for committed dancers.
            </h2>

          </div>



          <div class="intro-copy">

            <p>
              Company dancers are required to take a minimum of
              2 Genre classes, 1 Jumps and Turns class, and
              1–2 Ballet Classes weekly depending on age and
              team placement.
            </p>

          </div>


        </div>

      </section>



      <!-- =================================================
           MELVILLE COMPETITION TEAMS
           ================================================= -->

      <section class="program-index-section content-section">

        <div class="wrap">


          <div class="section-head dark">

            <div>

              <div class="eyebrow">
                Melville
              </div>

              <h2>
                Competition Teams
              </h2>

            </div>

          </div>



          <div class="program-cards modern-program-cards">


            {melvilleTeams.map((team) => (

              <article class="program-card modern-program-card">

                <img
                  src={team.image}
                  alt={`AIM Melville ${team.name} Competition Team`}
                  loading="lazy"
                />

                <div>

                  <span>
                    Melville Competition Team
                  </span>

                  <h2>
                    {team.name}
                  </h2>

                  <p>
                    {team.ages}
                  </p>

                </div>

              </article>

            ))}


          </div>


        </div>

      </section>



      <!-- =================================================
           COMMACK COMPETITION TEAMS
           ================================================= -->

      <section class="content-section">

        <div class="wrap">


          <div class="section-head dark">

            <div>

              <div class="eyebrow">
                Commack
              </div>

              <h2>
                Competition Teams
              </h2>

            </div>

          </div>



          <div class="program-cards modern-program-cards">


            {commackTeams.map((team) => (

              <article class="program-card modern-program-card">

                <img
                  src={team.image}
                  alt={`AIM Commack ${team.name} Competition Team`}
                  loading="lazy"
                />

                <div>

                  <span>
                    Commack Competition Team
                  </span>

                  <h2>
                    {team.name}
                  </h2>

                  <p>
                    {team.ages}
                  </p>

                </div>

              </article>

            ))}


          </div>


        </div>

      </section>



      <!-- =================================================
           DANCER SPOTLIGHT
           ================================================= -->

      <section class="home-staff-section">

        <div class="wrap section-head dark">


          <div>

            <div class="eyebrow">
              Dancer Spotlight
            </div>

            <h2>
              AIM dancers beyond the competition stage.
            </h2>

          </div>


          <p>
            Celebrating professional opportunities and achievements
            earned by AIM competitive dancers.
          </p>


        </div>



        <div class="staff-carousel-shell">


          <div
            class="staff-carousel"
            aria-label="AIM Dancer Spotlight"
          >


            {dancerFeatures.map((feature) => (

              <article class="home-staff-card">


                <div class="home-staff-photo">

                  <img
                    src={feature.image}
                    alt={feature.title}
                    loading="lazy"
                  />

                </div>


                <div>

                  <p>
                    Dancer Spotlight
                  </p>

                  <h3>
                    {feature.title}
                  </h3>

                </div>


              </article>

            ))}


          </div>


        </div>


      </section>

    </>

  )}



  <!-- =====================================================
       PROGRAM CTA
       ===================================================== -->

  {isProgram && (

    <section class="page-cta-band">

      <div class="wrap">


        <div>

          <div class="eyebrow light">
            Ready to begin?
          </div>

          <h2>
            Find the right class at AIM.
          </h2>

        </div>



        <div class="actions">

          <a
            class="btn btn-light"
            href="/schedules"
          >
            View schedules
          </a>

          <a
            class="btn outline staff-cta-outline"
            href="/contact"
          >
            Contact us
          </a>

        </div>


      </div>

    </section>

  )}

</Base>
