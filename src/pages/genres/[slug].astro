---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';


/* =========================================================
   GENRE ROUTES
   ========================================================= */

export function getStaticPaths() {

  const genres = {

    'ballet-pointe': {
      name: 'Ballet & Pointe',
      image: '/uploads/drive/genres/ballet.jpg',
      description:
        'Build strength, alignment, flexibility and classical technique through structured ballet training.',
      note:
        'Pointe registration is only available to our more advanced dancers with studio approval necessary in order to keep our dancers safe.'
    },

    'jazz': {
      name: 'Jazz',
      image: '/uploads/drive/genres/jazz.jpg',
      description:
        'High-energy movement focused on musicality, turns, jumps, flexibility and performance quality.'
    },

    'tap': {
      name: 'Tap',
      image: '/uploads/drive/genres/tap.jpg',
      description:
        'Develop rhythm, musicality and precise footwork while learning to create movement through sound.'
    },

    'lyrical': {
      name: 'Lyrical',
      image: '/uploads/drive/genres/lyrical.png',
      description:
        'A blend of ballet and jazz that combines technique, fluid movement and emotional storytelling.'
    },

    'contemporary': {
      name: 'Contemporary',
      image: '/uploads/drive/genres/contemporary.jpg',
      description:
        'Explore expressive movement, musicality, floor work and dynamic technique in a creative environment.'
    },

    'hip-hop': {
      name: 'Hip Hop',
      image: '/uploads/drive/genres/hip-hop.jpg',
      description:
        'Energetic movement incorporating rhythm, grooves, musicality and current street-dance influences.'
    },

    'acro': {
      name: 'Acro',
      image: '/uploads/drive/genres/acro.jpg',
      description:
        'Combine dance technique with flexibility, strength, balance and controlled acrobatic skills.'
    },

    'jumps-turns': {
      name: 'Jumps & Turns',
      image: '/uploads/drive/genres/jumps-turns.jpg',
      description:
        'Focused technique training designed to strengthen jumps, turns, control, alignment and performance consistency.',
      note:
        'Mandatory for company dancers. Also available to recreational students upon request.'
    }

  };


  return Object.entries(genres).map(([slug, genre]) => ({

    params: {
      slug
    },

    props: {
      genre,
      slug
    }

  }));

}


const { genre, slug } = Astro.props;



/* =========================================================
   STAFF DATA
   ========================================================= */

const allStaff = await getCollection('staff');


async function createStaffProfile(name) {

  const person = allStaff.find(
    (entry) =>
      entry.data.name.trim().toLowerCase() ===
      name.trim().toLowerCase()
  );

  if (!person) {
    return null;
  }

  const { Content } = await render(person);

  return {
    person,
    BioContent: Content,
    hasBio: Boolean(person.body?.trim())
  };

}



/* =========================================================
   ACRO STAFF
   ========================================================= */

const gayleProfile = await createStaffProfile('Gayle Biegel');



/* =========================================================
   TAP STAFF
   ========================================================= */

const tapInstructorNames = [
  'Maggie Venti',
  'Jennifer Palilla',
  'Natalie Schiff'
];


const tapStaff = (
  await Promise.all(
    tapInstructorNames.map((name) => createStaffProfile(name))
  )
).filter(Boolean);


const tapBioComingSoon = [
  'Maggie Venti',
  'Jennifer Palilla'
];
---

<Base
  title={`${genre.name} | Art In Motion Dance Center`}
  description={genre.description}
>


  <!-- =====================================================
       GENRE HERO
       ===================================================== -->

  <section class="genre-detail-hero">

    <img
      src={genre.image}
      alt={`${genre.name} at Art In Motion Dance Center`}
      class="genre-detail-hero-image"
    />

    <div
      class="genre-detail-overlay"
      aria-hidden="true"
    ></div>


    <div class="wrap genre-detail-hero-content">

      {slug === 'jumps-turns' ? (

        <div class="eyebrow light">
          New Genre · Dance at AIM
        </div>

      ) : (

        <div class="eyebrow light">
          Dance at AIM
        </div>

      )}


      <h1>
        {genre.name}
      </h1>

    </div>

  </section>



  <!-- =====================================================
       GENRE INTRODUCTION
       ===================================================== -->

  <section class="genre-detail-intro">

    <div class="wrap genre-detail-intro-grid">


      <div class="genre-detail-heading">

        <div class="eyebrow">
          Explore the style
        </div>

        <h2>
          Discover {genre.name}.
        </h2>

      </div>


      <div class="genre-detail-copy">

        <p>
          {genre.description}
        </p>


        {genre.note && (

          <div class="genre-detail-note">
            {genre.note}
          </div>

        )}


        <a
          href="/schedules"
          class="btn"
        >
          View schedules
        </a>

      </div>


    </div>

  </section>



  <!-- =====================================================
       BALLET & POINTE
       SINGLE VIDEO — TEXT LEFT / VIDEO RIGHT
       ===================================================== -->

  {slug === 'ballet-pointe' && (

    <section class="genre-video-section">

      <div class="wrap">

        <div class="genre-video-heading">


          <div class="competition-video-copy">

            <div class="eyebrow light">
              Ballet &amp; Pointe at AIM
            </div>

            <h2>
              Grace.<br/>
              Strength.<br/>
              Technique.
            </h2>

            <p>
              Ballet training builds the foundation for strong technique,
              alignment, control and artistry. Pointe is offered to advanced
              dancers with studio approval to ensure safe and appropriate
              progression.
            </p>

          </div>



          <div class="genre-video-grid genre-video-grid-single">

            <article class="genre-video-card">

              <div class="genre-video-media">

                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="Ballet and Pointe training at AIM"
                >

                  <source
                    src="/uploads/drive/videos/ballet-pointe.mp4"
                    type="video/mp4"
                  />

                  Your browser does not support video playback.

                </video>

              </div>

            </article>

          </div>


        </div>

      </div>

    </section>

  )}



  <!-- =====================================================
       ACRO VIDEOS
       ===================================================== -->

  {slug === 'acro' && (

    <section class="genre-video-section">

      <div class="wrap">


        <div class="genre-video-heading">

          <div>

            <div class="eyebrow light">
              Acro at AIM
            </div>

            <h2>
              Strength. Control.<br/>
              Confidence.
            </h2>

          </div>


          <p>
            See AIM dancers develop the flexibility, strength,
            balance and controlled technique used throughout
            Acro training.
          </p>

        </div>



        <div class="genre-video-grid">


          <article class="genre-video-card">

            <div class="genre-video-media">

              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="Acro training video 1"
              >

                <source
                  src="/uploads/drive/videos/acro-1.mp4"
                  type="video/mp4"
                />

                Your browser does not support video playback.

              </video>

            </div>

          </article>



          <article class="genre-video-card">

            <div class="genre-video-media">

              <video
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label="Acro training video 2"
              >

                <source
                  src="/uploads/drive/videos/acro-2.mp4"
                  type="video/mp4"
                />

                Your browser does not support video playback.

              </video>

            </div>

          </article>


        </div>

      </div>

    </section>

  )}



  <!-- =====================================================
       ACRO INSTRUCTOR
       ===================================================== -->

  {slug === 'acro' && gayleProfile && (

    <section class="genre-instructor-section">

      <div class="wrap">


        <div class="genre-instructor-heading">

          <div class="eyebrow">
            Meet your instructor
          </div>

          <h2>
            Learn Acro with AIM.
          </h2>

        </div>



        <article class="genre-instructor-card">


          <div class="genre-instructor-photo">

            {gayleProfile.person.data.photo ? (

              <img
                src={gayleProfile.person.data.photo}
                alt={gayleProfile.person.data.name}
                loading="lazy"
              />

            ) : (

              <div class="genre-instructor-placeholder">
                {gayleProfile.person.data.name}
              </div>

            )}

          </div>



          <div class="genre-instructor-copy">

            <span class="genre-instructor-label">
              Resident Acro Instructor
            </span>


            <h3>
              Gayle Biegel
            </h3>


            <p class="genre-instructor-role">
              {gayleProfile.person.data.role}
            </p>


            <div class="genre-instructor-bio">

              <p>
                Gayle Biegel has a Bachelor of Science Degree in Physical
                Education from Brooklyn College. She has been teaching
                gymnastics for 38 years. (Recreation and competitive)
                Gayle was a competitive coach for about 25 years and she
                trained competitive gymnasts up to Level 10 (some who have
                gone to nationals and received full scholarships to college).
              </p>

              <p>
                Additionally, she is a beam coach and choreographer.
                Gayle has been the head of a gymnastics program at
                Camp Wah-Nee for 15 years.
              </p>

            </div>

          </div>


        </article>

      </div>

    </section>

  )}



  <!-- =====================================================
       TAP
       SINGLE VIDEO — TEXT LEFT / VIDEO RIGHT
       ===================================================== -->

  {slug === 'tap' && (

    <section class="genre-video-section">

      <div class="wrap">

        <div class="genre-video-heading">


          <div class="competition-video-copy">

            <div class="eyebrow light">
              Tap at AIM
            </div>

            <h2>
              Rhythm.<br/>
              Musicality.<br/>
              Precision.
            </h2>

            <p>
              Tap training at AIM develops musicality, timing,
              coordination and precise footwork while encouraging
              dancers to create rhythm through movement.
            </p>

          </div>



          <div class="genre-video-grid genre-video-grid-single">

            <article class="genre-video-card">

              <div class="genre-video-media">

                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="Tap dance training at AIM"
                >

                  <source
                    src="/uploads/drive/videos/tap.mp4"
                    type="video/mp4"
                  />

                  Your browser does not support video playback.

                </video>

              </div>

            </article>

          </div>


        </div>

      </div>

    </section>

  )}



  <!-- =====================================================
       TAP INSTRUCTORS
       ===================================================== -->

  {slug === 'tap' && tapStaff.length > 0 && (

    <section class="genre-instructor-section tap-instructors-section">

      <div class="wrap">


        <div class="genre-instructor-heading">

          <div class="eyebrow">
            Meet your instructors
          </div>

          <h2>
            Learn Tap with AIM.
          </h2>

        </div>



        <div class="tap-instructor-grid">


          {tapStaff.map(({ person, BioContent, hasBio }) => (

            <article class="tap-instructor-card">


              <div class="tap-instructor-photo">

                {person.data.photo ? (

                  <img
                    src={person.data.photo}
                    alt={person.data.name}
                    loading="lazy"
                  />

                ) : (

                  <div class="genre-instructor-placeholder">
                    {person.data.name}
                  </div>

                )}

              </div>



              <div class="tap-instructor-copy">

                <span class="genre-instructor-label">
                  Tap Instructor
                </span>


                <h3>
                  {person.data.name}
                </h3>


                <p class="genre-instructor-role">
                  {person.data.role}
                </p>


                <div class="genre-instructor-bio">


                  {tapBioComingSoon.includes(person.data.name) ? (

                    <p>
                      Bio coming soon.
                    </p>

                  ) : hasBio ? (

                    <BioContent />

                  ) : (

                    <p>
                      Bio coming soon.
                    </p>

                  )}


                </div>

              </div>


            </article>

          ))}


        </div>

      </div>

    </section>

  )}



  <!-- =====================================================
       JUMPS & TURNS
       SINGLE VIDEO — TEXT LEFT / VIDEO RIGHT
       ===================================================== -->

  {slug === 'jumps-turns' && (

    <section class="genre-video-section">

      <div class="wrap">

        <div class="genre-video-heading">


          <div class="competition-video-copy">

            <div class="eyebrow light">
              New Genre at AIM
            </div>

            <h2>
              Elevate your<br/>
              technique.
            </h2>

            <p>
              Jumps &amp; Turns focuses on strength, control,
              alignment, elevation and consistency to help dancers
              develop cleaner and more confident technical skills.
            </p>

          </div>



          <div class="genre-video-grid genre-video-grid-single">

            <article class="genre-video-card">

              <div class="genre-video-media">

                <video
                  autoplay
                  muted
                  loop
                  playsinline
                  preload="metadata"
                  aria-label="Jumps and Turns training at AIM"
                >

                  <source
                    src="/uploads/drive/videos/jumps-turns.mp4"
                    type="video/mp4"
                  />

                  Your browser does not support video playback.

                </video>

              </div>

            </article>

          </div>


        </div>

      </div>

    </section>

  )}



  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <section class="page-cta-band">

    <div class="wrap">

      <div>

        <div class="eyebrow light">
          Ready to dance?
        </div>

        <h2>
          Find your class at AIM.
        </h2>

      </div>


      <div class="actions">

        <a
          class="btn btn-light"
          href="/schedules"
        >
          View schedules
        </a>


        <a
          class="btn outline staff-cta-outline"
          href="/contact"
        >
          Contact us
        </a>

      </div>

    </div>

  </section>


</Base>
