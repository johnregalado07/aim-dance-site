---
import Base from '../layouts/Base.astro';

const genreCards = [
  {
    name: 'Ballet & Pointe',
    image: '/uploads/drive/genres/ballet.jpg',
    href: '/genres/ballet-pointe/',
    description:
      'Build strength, alignment, flexibility and classical technique through structured ballet and pointe training.'
  },

  {
    name: 'Jazz',
    image: '/uploads/drive/genres/jazz.jpg',
    href: '/genres/jazz/',
    description:
      'High-energy movement focused on musicality, turns, jumps, flexibility and performance quality.'
  },

  {
    name: 'Tap',
    image: '/uploads/drive/genres/tap.jpg',
    href: '/genres/tap/',
    description:
      'Develop rhythm, musicality and precise footwork while learning to create movement through sound.'
  },

  {
    name: 'Lyrical',
    image: '/uploads/drive/genres/lyrical.png',
    href: '/genres/lyrical/',
    description:
      'A blend of ballet and jazz that combines technique, fluid movement and emotional storytelling.'
  },

  {
    name: 'Contemporary',
    image: '/uploads/drive/genres/contemporary.jpg',
    href: '/genres/contemporary/',
    description:
      'Explore expressive movement, musicality, floor work and dynamic technique in a creative environment.'
  },

  {
    name: 'Hip Hop',
    image: '/uploads/drive/genres/hip-hop.jpg',
    href: '/genres/hip-hop/',
    description:
      'Energetic movement incorporating rhythm, grooves, musicality and current street-dance influences.'
  },

  {
    name: 'Acro',
    image: '/uploads/drive/genres/acro.jpg',
    href: '/genres/acro/',
    description:
      'Combine dance technique with flexibility, strength, balance and controlled acrobatic skills.'
  },

  {
    name: 'Jumps & Turns',
    image: '/uploads/drive/kickline/kickline-1.jpg',
    href: '/genres/jumps-turns/',
    description:
      'Focused technique training designed to strengthen jumps, turns, control, alignment and performance consistency.'
  }
];
---

<Base
  title="Dance Genres | AIM Dance"
  description="Explore the dance styles offered at Art In Motion Dance Center."
>

  <!-- =========================================
       HERO
       ========================================= -->

  <section class="genres-showcase-hero">

    <div class="wrap">

      <div class="eyebrow light">
        Find your movement
      </div>

      <h1>
        Dance Genres
      </h1>

      <p>
        Explore the styles offered at Art In Motion Dance Center and
        discover the training that inspires your dancer.
      </p>

    </div>

  </section>



  <!-- =========================================
       GENRE CARDS
       ========================================= -->

  <section class="genres-showcase">

    <div class="wrap">


      <div class="genres-showcase-intro">

        <div>

          <div class="eyebrow">
            Train with AIM
          </div>

          <h2>
            Find the style that moves you.
          </h2>

        </div>


        <p>
          From foundational technique to high-energy performance,
          AIM offers a variety of dance styles designed to help dancers
          grow in confidence, artistry and ability.
        </p>

      </div>



      <div class="genres-showcase-grid">

        {genreCards.map((genre, index) => (

          <a
            class="genre-showcase-card"
            href={genre.href}
            aria-label={`Learn more about ${genre.name}`}
          >

            <img
              src={genre.image}
              alt={`${genre.name} classes at Art In Motion Dance Center`}
              loading="lazy"
            />


            <div
              class="genre-showcase-overlay"
              aria-hidden="true"
            ></div>


            <div class="genre-showcase-content">

              <span class="genre-showcase-number">
                {String(index + 1).padStart(2, '0')}
              </span>


              <h2>
                {genre.name}
              </h2>


              <div class="genre-showcase-description">

                <p>
                  {genre.description}
                </p>

              </div>

            </div>

          </a>

        ))}

      </div>


    </div>

  </section>



  <!-- =========================================
       FINAL CTA
       ========================================= -->

  <section class="page-cta-band">

    <div class="wrap">

      <div>

        <div class="eyebrow light">
          Ready to dance?
        </div>

        <h2>
          Find your class at AIM.
        </h2>

      </div>


      <div class="actions">

        <a
          class="btn btn-light"
          href="/schedules"
        >
          View schedules
        </a>


        <a
          class="btn outline staff-cta-outline"
          href="/contact"
        >
          Contact us
        </a>

      </div>

    </div>

  </section>

</Base>
