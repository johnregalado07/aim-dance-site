---
import '../styles/global.css';
import banner from '../data/banner.json';
import site from '../data/locations.json';
import { getCollection } from 'astro:content';
const { title = 'Art In Motion Dance Center', description = 'Technique-focused competitive and recreational dance in Melville and Commack, NY.' } = Astro.props;
const programs = (await getCollection('pages')).filter((p) => p.data.section === 'programs').sort((a, b) => a.data.order - b.data.order);
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#800020" />
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  {banner.show && <div class="banner" role="status">{banner.message}</div>}
  <div class="topbar">
    <div class="wrap">
      {site.locations.map((l) => <a href={`tel:${l.phone.replace(/\D/g, '')}`}>{l.name} {l.phone}</a>)}
      <span class="spacer"></span>
      {site.locations.map((l) => <a class="pill" href={l.portal}>{l.name} portal</a>)}
    </div>
  </div>
  <header class="site">
    <div class="wrap">
      <a class="logo" href="/">AIM Dance</a>
      <button class="menu-btn" aria-expanded="false" aria-controls="nav">Menu</button>
      <nav id="nav" aria-label="Main">
        <a href="/about-us" aria-current={path.startsWith('/about') ? 'page' : undefined}>About</a>
        <a href="/staff">Staff</a>
        <div class="dd">
          <a href="/programs">Programs</a>
          <div class="dd-menu">
            {programs.map((p) => <a href={`/${p.id}`}>{p.data.title}</a>)}
          </div>
        </div>
        <a href="/testimonials">Testimonials</a>
        <a href="/blog">Blog</a>
        <a href="/events">Events</a>
        <a href="/calendar">Calendar</a>
        <a href="/schedules">Schedules</a>
        <a class="btn small" href="/contact">Contact</a>
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <footer>
    <div class="wrap">
      <div>
        <strong>Art In Motion Dance Center</strong>
        {site.locations.map((l) => <p>{l.name}: {l.address}</p>)}
      </div>
      <div>
        <p>© 2020–{new Date().getFullYear()} AIM Dance</p>
        <p><a href={site.facebook}>Facebook</a> · <a href={site.instagram}>Instagram</a></p>
      </div>
    </div>
  </footer>
  <script is:inline>
    var b = document.querySelector('.menu-btn'), n = document.getElementById('nav');
    b.addEventListener('click', function () { var o = n.classList.toggle('open'); b.setAttribute('aria-expanded', o); });
  </script>
</body>
</html>
